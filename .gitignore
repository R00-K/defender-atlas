# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
src/*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# mypy
.mypy_cache/

# pytest / coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ruff
.ruff_cache/

# Black
*.black

# Jupyter
.ipynb_checkpoints/

# ProcMon / analysis outputs (large files — keep out of git)
*.CSV
*.csv
!datasets/*.csv
!datasets/**/*.csv

# Binary samples (malware bait files, executables)
*.exe
*.dll
*.bin
*.apk
*.zip
*.rar
*.7z
!datasets/*.zip
!datasets/**/*.zip

# Images generated by analysis
*.png
*.jpg
*.gif
!docs/*.png

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# Reports generated by tools
reports/*.txt
reports/*.html
reports/*.json
!reports/.gitkeep

# Hypothesis / Nox
.hypothesis/
.nox/
